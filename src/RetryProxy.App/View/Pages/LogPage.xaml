<Page x:Class="RetryProxy.View.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="LogPage"
      d:DataContext="{d:DesignInstance Type=pages:LogPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="LogRowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="48,20,48,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  头部：第一行 标题 + 操作，第二行 过滤 + 搜索  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{i18n:T 运行日志}" />
                    <TextBlock Margin="8,2,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Counter}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="{i18n:T 自动滚动}"
                              IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              ToolTip="{Binding AutoScrollToolTip}" />
                    <ui:Button Command="{Binding OpenDirectoryCommand}"
                               Content="{i18n:T 打开目录}"
                               Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button Margin="8,0,0,0"
                               Command="{Binding ClearCommand}"
                               Content="{i18n:T 清空}"
                               Icon="{ui:SymbolIcon Broom24}" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ui:Button Margin="0"
                               Appearance="{Binding IsAll, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="all"
                               Content="{i18n:T 全部}"
                               Style="{StaticResource ChipButton}" />
                    <ui:Button Appearance="{Binding IsInfo, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="info"
                               Content="{i18n:T 信息}"
                               Style="{StaticResource ChipButton}" />
                    <ui:Button Appearance="{Binding IsWarning, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="warning"
                               Content="{i18n:T 警告}"
                               Style="{StaticResource ChipButton}" />
                    <ui:Button Appearance="{Binding IsError, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="error"
                               Content="{i18n:T 错误}"
                               Style="{StaticResource ChipButton}" />
                    <ui:Button Margin="8,0,0,0"
                               Appearance="{Binding OnlyKeepAlive, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding ToggleKeepAliveCommand}"
                               Content="{i18n:T 保活}"
                               Style="{StaticResource ChipButton}" />
                    <Border Width="1"
                            Height="16"
                            Margin="10,0,6,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Visibility="{Binding HasSelectedRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button Appearance="{Binding OnlySelected, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding ToggleOnlySelectedCommand}"
                               Content="{Binding OnlySelectedLabel}"
                               Style="{StaticResource ChipButton}"
                               Visibility="{Binding HasSelectedRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <ui:TextBox Grid.Column="1"
                            Width="220"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{i18n:T 搜索关键字 / 请求 ID}"
                            Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </Grid>
        </StackPanel>

        <!--  日志列表  -->
        <Border Grid.Row="1"
                Padding="9,6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <ListBox x:Name="LogList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogRowStyle}"
                         ItemsSource="{Binding Rows}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:LogLineTextBlock FontFamily="Consolas"
                                                       FontSize="12"
                                                       Line="{Binding}"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="4"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           IsHitTestVisible="False"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
