<Page x:Class="RetryProxy.View.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:markup="clr-namespace:RetryProxy.Markup"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:viewModel="clr-namespace:RetryProxy.ViewModel"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SettingsPage"
      d:DataContext="{d:DesignInstance Type=pages:SettingsPageViewModel}"
      d:DesignHeight="800"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{i18n:T 软件设置}" />

            <!--  界面语言  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 软件UI语言}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="UI Language"
                                      TextWrapping="Wrap" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  Width="200"
                                  Margin="0,0,36,0"
                                  DisplayMemberPath="Value"
                                  ItemsSource="{Binding LanguageDict}"
                                  SelectedItem="{Binding Config.OtherConfig.UiCultureInfoName, Converter={StaticResource CultureInfoNameToKVPConverter}, Mode=TwoWay}"
                                  SelectedValuePath="Key">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:InvokeCommandAction Command="{Binding UiLanguageSelectionChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ComboBox>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- 直接复用主窗口的主题命令，避免页面通过祖先绑定取不到命令。 -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Blur24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{i18n:T 外观}" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 切换深浅主题或背景样式}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button AutomationProperties.AutomationId="SwitchAppearance"
                           Command="{Binding SwitchBackdropCommand, Source={markup:ServiceLocator Type={x:Type viewModel:MainWindowViewModel}}}"
                           Content="{i18n:T 切换外观}" Icon="{ui:SymbolIcon Blur24}" />
            </ui:CardControl>

            <!-- 客户端接管：每个客户端保留独立的持久选择。 -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="{i18n:T 客户端接管}" FontWeight="SemiBold" FontSize="16" />
                    <ItemsControl ItemsSource="{Binding Clients}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,8,0,12">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" AutomationProperties.AutomationId="ClientConnectionStatus" />
                                    <ui:Button Content="{Binding TakeoverText}" Command="{Binding TakeOverCommand}" IsEnabled="{Binding CanTakeOver}" Margin="12,0,0,0" Padding="8,4" />
                                    <ui:Button Content="{i18n:T 取消接管}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Margin="8,0,0,0" Padding="8,4" AutomationProperties.AutomationId="{Binding Client, StringFormat='CancelTakeover_{0}'}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ConfigPath}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,4,0,0">
                                    <ui:Button Content="{i18n:T 打开配置目录}" Command="{Binding OpenConfigCommand}" Padding="8,4" />
                                    <ui:Button Content="{i18n:T 打开备份目录}" Command="{Binding OpenBackupCommand}" ToolTip="{Binding BackupPath}" Margin="8,0,0,0" Padding="8,4" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{i18n:T 配置和备份含明文 Key，请妥善保管。}" TextWrapping="Wrap" />
                    <TextBlock Text="{i18n:T 环境变量、项目配置或其他客户端目录可能覆盖本机地址；已接管仅确认当前配置文件，不代表所有窗口已连接代理。}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{i18n:T 本机代理统一使用当前 Key；本机其他程序也能使用该 Key。}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{i18n:T 软件意外退出后，重新启动本软件可恢复连接。}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <ui:Button Content="{i18n:T 打开首次设置向导}" Command="{Binding ClientSetupCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ClientSetup" />
                </StackPanel>
            </ui:Card>

            <!--  日志目录  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon DocumentText24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{i18n:T 日志目录}" TextWrapping="Wrap" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding LogDirectory}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding OpenLogDirectoryCommand}"
                           Content="{i18n:T 打开目录}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="{i18n:T 运行日志 retry-proxy.log 所在目录}" />
            </ui:CardControl>

            <!--  每日统计目录  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon DataHistogram24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{i18n:T 每日统计目录}" TextWrapping="Wrap" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding StatisticsDirectory}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding OpenStatisticsDirectoryCommand}"
                           Content="{i18n:T 打开目录}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="{i18n:T 每个通道一个子目录，按天保存 jsonl 统计记录}" />
            </ui:CardControl>

            <!--  随系统启动  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon LinkSquare24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 开机自动启动}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 登录系统后自动运行两个客户端的代理；尚无供应商的客户端等待添加。}"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="0,0,24,0"
                                         IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 启动时最小化到托盘}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 启动后不显示主窗口，仅保留托盘图标}"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.CommonConfig.StartMinimized, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 关闭窗口时最小化到托盘}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 点击关闭按钮不退出程序，代理继续在后台运行}"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.CommonConfig.ExitToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
