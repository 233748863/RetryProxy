<Page x:Class="RetryProxy.View.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AboutPage"
      d:DataContext="{d:DesignInstance Type=pages:AboutPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{i18n:T 关于}" />

            <!--  程序与版本  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Info24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Body" Text="{i18n:T LLM Retry Proxy}" />
                            <ui:TextBlock Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{Binding VersionText}" />
                        </StackPanel>
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Summary}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding OpenUrlCommand}"
                           CommandParameter="{x:Static pages:AboutPageViewModel.RepositoryUrl}"
                           Content="{i18n:T 项目主页}"
                           Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>

            <!--  许可证  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Certificate24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{i18n:T 许可证：GPL-3.0}" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding LicenseText}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding OpenUrlCommand}"
                           CommandParameter="{x:Static pages:AboutPageViewModel.LicenseUrl}"
                           Content="{i18n:T 许可证全文}"
                           Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>

            <!--  依赖致谢  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Library24}"
                             IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{i18n:T 依赖致谢}" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 感谢以下开源项目}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <ItemsControl ItemsSource="{Binding Dependencies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="{Binding Name}" />
                                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding Note}"
                                                      TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               Margin="12,0,20,0"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Url}"
                                               Content="{i18n:T 打开}"
                                               Icon="{ui:SymbolIcon Open24}" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
