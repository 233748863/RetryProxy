<Page x:Class="RetryProxy.View.Pages.PreparationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="PreparationPage"
      d:DataContext="{d:DesignInstance Type=pages:PreparationPageViewModel}"
      d:DesignHeight="550"
      d:DesignWidth="700"
      FontFamily="{StaticResource TextThemeFontFamily}"
      FontSize="{StaticResource ControlContentThemeFontSize}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="PreparationCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{i18n:T 一键准备}" />
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           AutomationProperties.AutomationId="AddPreparation"
                           Command="{Binding AddPreparationCommand}"
                           Content="{i18n:T 新增准备}"
                           Icon="{ui:SymbolIcon Add24}" />
            </Grid>
            <TextBlock Margin="0,0,0,4" Style="{StaticResource BodyTextBlockStyle}" Text="{i18n:T 独立选择客户端、供应商与模型，准备成功后自动保活。}" TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,12"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{i18n:T 每项准备单独启停，设置与会话在关闭软件后清空。}"
                       TextWrapping="Wrap" />

            <Border Style="{StaticResource PreparationCard}"
                    Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <StackPanel Margin="0,12">
                    <ui:SymbolIcon Margin="0,0,0,8" FontSize="24" Symbol="PlayCircle24" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{i18n:T 尚未添加准备任务}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{i18n:T 点击“新增准备”选择客户端和供应商。}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,0,0,8"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Summary}"
                       Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:PreparationTaskViewModel}">
                        <Border Style="{StaticResource PreparationCard}" AutomationProperties.AutomationId="{Binding Id}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0"
                                                         IsIndeterminate="{Binding IsPreparing}"
                                                         Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Status}" AutomationProperties.AutomationId="PreparationStatus" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,4" Style="{StaticResource BodyTextBlockStyle}" Text="{Binding ProviderUrl}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Settings}" TextWrapping="Wrap" />
                                <Separator Margin="0,12,0,8" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{Binding Hint}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Statistics}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding Error}" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Margin="0,0,8,4"
                                               Appearance="Primary"
                                               Command="{Binding DataContext.StartPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Id}"
                                               Content="{i18n:T 开始准备}"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button Margin="0,0,8,4"
                                               Command="{Binding DataContext.StopPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Id}"
                                               Content="{Binding StopText}"
                                               Icon="{ui:SymbolIcon Stop24}"
                                               Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button Margin="0,0,8,4"
                                               Command="{Binding DataContext.EditPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Id}"
                                               Content="{i18n:T 修改设置}"
                                               Icon="{ui:SymbolIcon Edit24}"
                                               IsEnabled="{Binding CanStart}" />
                                    <ui:Button Margin="0,0,0,4"
                                               Command="{Binding DataContext.RemovePreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Id}"
                                               Content="{i18n:T 删除}"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               IsEnabled="{Binding CanStart}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
