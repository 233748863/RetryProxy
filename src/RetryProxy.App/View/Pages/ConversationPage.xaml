<UserControl x:Class="RetryProxy.View.Pages.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,0,10,3" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="RowBorder" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /><Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Periods}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Period}" MinWidth="120" Margin="0,0,8,8" AutomationProperties.AutomationId="ConversationPeriod" AutomationProperties.Name="{i18n:T 统计期间}" />
            <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Client}" MinWidth="140" Margin="0,0,12,8" AutomationProperties.AutomationId="ConversationClient" AutomationProperties.Name="{i18n:T 客户端}" />
            <CheckBox Content="{i18n:T 自动刷新}" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="0,0,12,8" AutomationProperties.AutomationId="ConversationAutoRefresh" />
            <ui:Button Content="{i18n:T 刷新}" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,0,8" AutomationProperties.AutomationId="ConversationRefresh" />
        </WrapPanel>
        <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <UniformGrid Columns="3" Margin="0,0,-8,14">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{i18n:T 会话}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding ConversationCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" AutomationProperties.AutomationId="ConversationCount" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{i18n:T 已结束请求}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding RequestCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" AutomationProperties.AutomationId="ConversationRequestCount" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" ToolTip="{i18n:T 费用采用当前模型单价估算；缺少价格或用量时以 ≥ 标记已知部分}"><StackPanel><TextBlock Text="{i18n:T 估算费用}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Cost}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        </UniformGrid>
        <TextBlock Text="{Binding Updated}" Style="{StaticResource Muted}" Margin="0,0,0,5" />
        <TextBlock Text="{Binding Unassigned}" Style="{StaticResource Muted}" Margin="0,0,0,14" />
        <TextBlock Text="{i18n:T 暂无记录，日常请求结束后会显示在这里}" Style="{StaticResource Muted}" Margin="0,0,0,14" Visibility="{Binding HasConversations, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
        <Grid x:Name="Lists" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="GroupCard" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{i18n:T 会话}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Height="232" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ConversationList">
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Cost}" Margin="10,0,0,0" FontSize="11" /></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding GroupPageCaption}" Style="{StaticResource Muted}" Margin="0,10,0,8" />
                    <StackPanel Orientation="Horizontal"><ui:Button Content="{i18n:T 上一页}" Command="{Binding PreviousGroupCommand}" Padding="10,5" Margin="0,0,6,0" /><ui:Button Content="{i18n:T 下一页}" Command="{Binding NextGroupCommand}" Padding="10,5" AutomationProperties.AutomationId="ConversationNextGroup" /></StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="RequestCard" Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{i18n:T 会话内请求}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" Height="232" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ConversationRequests">
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Cost}" Margin="10,0,0,0" FontSize="11" /></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding RequestPageCaption}" Style="{StaticResource Muted}" Margin="0,10,0,8" />
                    <StackPanel Orientation="Horizontal"><ui:Button Content="{i18n:T 上一页}" Command="{Binding PreviousRequestCommand}" Padding="10,5" Margin="0,0,6,0" /><ui:Button Content="{i18n:T 下一页}" Command="{Binding NextRequestCommand}" Padding="10,5" AutomationProperties.AutomationId="ConversationNextRequest" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{i18n:T 请求内容构成}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{i18n:T '上下文 = 本次发给模型的全部内容；Token = 模型计量文本的单位'}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <WrapPanel><TextBlock Text="{Binding ContextCaption}" FontSize="17" FontWeight="SemiBold" Margin="0,0,18,8" AutomationProperties.AutomationId="ConversationInput" /><TextBlock Text="{Binding CacheCaption}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="{Binding WindowCaption}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <ProgressBar Value="{Binding WindowProgress}" Height="4" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding Parts}" AutomationProperties.AutomationId="ConversationParts"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0" /><ProgressBar Grid.Column="1" Value="{Binding Percent}" Height="5" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding ContextHelp}" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                <TextBox Text="{Binding SelectedRequest.RequestId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{i18n:T 请求编号}" ToolTip="{i18n:T 可复制编号到请求日志或请求诊断中查找}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
