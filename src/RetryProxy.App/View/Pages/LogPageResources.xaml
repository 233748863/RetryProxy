<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RetryProxy.View.Controls"
                    xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="LogChip" BasedOn="{StaticResource ChipButton}" TargetType="ui:Button">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="LogTab" BasedOn="{StaticResource LogChip}" TargetType="ui:Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style x:Key="LogColumn" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="LogCell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 窄窗口把耗时留在详情，优先保证模型名称可读。 -->
    <Style x:Key="LogDurationHeader" BasedOn="{StaticResource LogColumn}" TargetType="TextBlock">
        <Setter Property="Width" Value="88" />
        <Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="LogDurationCell" TargetType="StackPanel">
        <Setter Property="Width" Value="88" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogSecondary" BasedOn="{StaticResource LogCell}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,4,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="LogDetailText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="LogResult" BasedOn="{StaticResource LogCell}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Failure"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Pending"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogLevelText" BasedOn="{StaticResource LogCell}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="WARNING"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogExpandGlyph" TargetType="TextBlock">
        <Setter Property="Text" Value="⌄" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="⌃" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="LogItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationText}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Selection" Background="Transparent" CornerRadius="6"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LogList" BasedOn="{StaticResource {x:Type ListBox}}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LogItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Tag" Value="NoSmoothScroll" />
    </Style>
    <Style x:Key="LogRowButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Height" Value="60" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="RequestLogTemplate">
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <ui:Button Style="{StaticResource LogRowButton}" Command="{Binding DataContext.ToggleRequestCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding RequestId}" ToolTip="{Binding RequestId}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="92" /><ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Time}" Style="{StaticResource LogCell}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Client}" Style="{StaticResource LogSecondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Model}" Style="{StaticResource LogCell}" FontWeight="SemiBold" ToolTip="{Binding Model}" />
                            <TextBlock Text="{Binding Provider}" Style="{StaticResource LogSecondary}" ToolTip="{Binding Provider}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tokens}" Style="{StaticResource LogCell}" ToolTip="{Binding UsageDetail}" />
                            <TextBlock Text="{Binding Cost}" Style="{StaticResource LogSecondary}" ToolTip="{Binding CostHelp}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Style="{StaticResource LogDurationCell}">
                            <TextBlock Text="{Binding Duration}" Style="{StaticResource LogCell}" />
                            <TextBlock Text="{Binding FirstContent}" Style="{StaticResource LogSecondary}" ToolTip="{Binding TimingDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource LogResult}" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource LogSecondary}" ToolTip="{Binding TimingDetail}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Style="{StaticResource LogExpandGlyph}" />
                    </Grid>
                </ui:Button>
                <Border Margin="12,0,12,10" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RequestId}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6,3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Copy24}"
                                       Command="{Binding DataContext.CopyRequestRowCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                       ToolTip="{i18n:T 复制完整请求编号}" AutomationProperties.Name="{i18n:T 复制完整请求编号}" />
                        </Grid>
                        <TextBlock Text="{Binding RequestDetail}" Style="{StaticResource LogDetailText}" />
                        <TextBlock Text="{Binding ModelDetail}" Style="{StaticResource LogDetailText}" />
                        <TextBlock Text="{Binding UsageDetail}" Style="{StaticResource LogDetailText}" />
                        <TextBlock Text="{Binding TimingDetail}" Style="{StaticResource LogDetailText}" />
                        <TextBlock Text="{Binding FailureText}" Style="{StaticResource LogDetailText}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <WrapPanel>
                            <ui:Button Content="{i18n:T 查看请求诊断}" Style="{StaticResource LogChip}" Command="{Binding DataContext.OpenRequestDiagnosticCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Content="{i18n:T 相关运行日志}" Style="{StaticResource LogChip}" Command="{Binding DataContext.OpenRequestEventsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LogEventTemplate">
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <ui:Button Style="{StaticResource LogRowButton}" Height="52" Command="{Binding DataContext.ToggleEventCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}" AutomationProperties.Name="{Binding Body}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" /><ColumnDefinition Width="60" /><ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Style="{StaticResource LogCell}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource LogLevelText}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source}" Style="{StaticResource LogCell}" />
                            <TextBlock Text="{Binding Route}" Style="{StaticResource LogSecondary}" ToolTip="{Binding Route}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Body}" Style="{StaticResource LogCell}" ToolTip="{Binding Body}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource LogExpandGlyph}" />
                    </Grid>
                </ui:Button>
                <Border Margin="12,0,12,10" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:LogLineTextBlock Line="{Binding FullLine}" FontFamily="Consolas" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding FullLine}" />
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
