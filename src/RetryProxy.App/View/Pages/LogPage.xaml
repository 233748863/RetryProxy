<Page x:Class="RetryProxy.View.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:logging="clr-namespace:RetryProxy.Core.Logging;assembly=RetryProxy.Core"
      xmlns:workspace="clr-namespace:RetryProxy.Core.Workspace;assembly=RetryProxy.Core"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="LogPage" FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary Source="LogPageResources.xaml" />
    </Page.Resources>
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <controls:ClientSelector />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{i18n:T 实时跟随}" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Margin="0,0,12,0"
                              AutomationProperties.AutomationId="LogLiveFollow"
                              ToolTip="{i18n:T 查看旧记录或展开详情后暂停跟随，点击回到最新继续。}" />
                    <ui:Button Content="{i18n:T 导出}" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportCommand}"
                               IsEnabled="{Binding CanExport}" AutomationProperties.AutomationId="ExportRuntimeLogs"
                               ToolTip="{i18n:T 导出当前筛选的全部页}" />
                    <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMoreClick"
                               AutomationProperties.AutomationId="LogMoreActions"
                               AutomationProperties.Name="{i18n:T 更多操作}" ToolTip="{i18n:T 更多操作}">
                        <ui:Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{i18n:T 刷新}" Command="{Binding RefreshCommand}" />
                                <MenuItem Header="{i18n:T 打开目录}" Command="{Binding OpenDirectoryCommand}" />
                                <MenuItem Header="{i18n:T 清空显示}" Command="{Binding ClearCommand}" IsEnabled="{Binding CanUseRows}"
                                          Visibility="{Binding IsEventView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{i18n:T 请求日志}" Style="{StaticResource LogTab}" Command="{Binding SetViewCommand}" CommandParameter="requests"
                               Appearance="{Binding IsRequestView, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               AutomationProperties.AutomationId="RequestLogsTab"
                               ToolTip="{i18n:T 最近 7 天的日常请求；准备、保活和服务启停请查看运行事件。}" />
                    <ui:Button Content="{i18n:T 运行事件}" Style="{StaticResource LogTab}" Command="{Binding SetViewCommand}" CommandParameter="events"
                               Appearance="{Binding IsEventView, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               AutomationProperties.AutomationId="RuntimeEventsTab" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <DatePicker Width="142" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" DisplayDateStart="{Binding EarliestDate}"
                                DisplayDateEnd="{Binding LatestDate}" SelectedDateFormat="Short" AutomationProperties.AutomationId="RuntimeLogDate" />
                    <ui:Button Content="{i18n:T 今天}" Margin="6,0,0,0" Command="{Binding TodayCommand}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsRequestView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Content="{i18n:T 全部}" Style="{StaticResource LogChip}" Command="{Binding SetRequestFilterCommand}" CommandParameter="all"
                               Appearance="{Binding IsAllRequests, Converter={StaticResource BooleanToChipAppearanceConverter}}" />
                    <ui:Button Content="{i18n:T 失败}" Style="{StaticResource LogChip}" Command="{Binding SetRequestFilterCommand}" CommandParameter="failed"
                               Appearance="{Binding IsFailedRequests, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               ToolTip="{i18n:T 请求失败或客户端交付中断}" AutomationProperties.AutomationId="RequestLogsFailed" />
                    <ui:Button Content="{i18n:T 重试}" Style="{StaticResource LogChip}" Command="{Binding SetRequestFilterCommand}" CommandParameter="retried"
                               Appearance="{Binding IsRetriedRequests, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               ToolTip="{i18n:T 至少发生过一次重试}" AutomationProperties.AutomationId="RequestLogsRetried" />
                    <ui:Button Content="{i18n:T 处理中}" Style="{StaticResource LogChip}" Command="{Binding SetRequestFilterCommand}" CommandParameter="pending"
                               Appearance="{Binding IsPendingRequests, Converter={StaticResource BooleanToChipAppearanceConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                            Visibility="{Binding IsEventView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox Width="132" SelectedValuePath="Tag" SelectedValue="{Binding SourceFilter, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LogSourceFilter" ToolTip="{i18n:T 来源}">
                        <ComboBoxItem Content="{i18n:T 全部来源}" Tag="{x:Null}" />
                        <ComboBoxItem Content="{i18n:T 通道代理}" Tag="{x:Static logging:LogSource.ChannelProxy}" />
                        <ComboBoxItem Content="{i18n:T 通道保活}" Tag="{x:Static logging:LogSource.ChannelKeepAlive}" />
                        <ComboBoxItem Content="{i18n:T 一键准备}" Tag="{x:Static logging:LogSource.Preparation}" />
                        <ComboBoxItem Content="{i18n:T 系统}" Tag="{x:Static logging:LogSource.System}" />
                    </ComboBox>
                    <ComboBox Width="102" Margin="6,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding Filter, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LogLevelFilter" ToolTip="{i18n:T 级别}">
                        <ComboBoxItem Content="{i18n:T 全部级别}" Tag="{x:Static workspace:LogLevelFilter.All}" />
                        <ComboBoxItem Content="{i18n:T 信息}" Tag="{x:Static workspace:LogLevelFilter.Info}" />
                        <ComboBoxItem Content="{i18n:T 警告}" Tag="{x:Static workspace:LogLevelFilter.Warning}" />
                        <ComboBoxItem Content="{i18n:T 错误}" Tag="{x:Static workspace:LogLevelFilter.Error}" />
                    </ComboBox>
                </StackPanel>
                <ui:TextBox Grid.Column="1" PlaceholderText="{Binding SearchHint}" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" MaxLength="256"
                            AutomationProperties.AutomationId="LogSearch" />
            </Grid>
            <Grid Height="30" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="{i18n:T 仅当前客户端}" ToolTip="{Binding OnlySelectedLabel}" IsChecked="{Binding OnlySelected, Mode=TwoWay}"
                          VerticalAlignment="Center" FontSize="12" AutomationProperties.AutomationId="LogSelectedClient"
                          Visibility="{Binding ShowClientFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" Margin="12,0" Text="{Binding FollowHint}" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding ShowFollowHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="LogFollowHint" />
                <ui:Button Grid.Column="2" Content="{i18n:T 回到最新}" Command="{Binding LatestCommand}" Padding="9,3" Appearance="Transparent"
                           Visibility="{Binding ShowFollowHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="LogReturnToLatest" />
            </Grid>
            <TextBlock Text="{Binding Warning}" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />
                <Grid Margin="12,0,28,0" Visibility="{Binding IsRequestView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="92" /><ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:T 时间}" Style="{StaticResource LogColumn}" />
                    <TextBlock Grid.Column="1" Text="{i18n:T 模型 / 供应商}" Style="{StaticResource LogColumn}" />
                    <TextBlock Grid.Column="2" Text="{i18n:T 用量 / 费用}" Style="{StaticResource LogColumn}" ToolTip="{i18n:T ↑ 输入用量，↓ 输出用量；费用按统计页的模型单价估算。}" />
                    <TextBlock Grid.Column="3" Text="{i18n:T 耗时}" Style="{StaticResource LogDurationHeader}" />
                    <TextBlock Grid.Column="4" Text="{i18n:T 结果}" Style="{StaticResource LogColumn}" />
                </Grid>
                <Grid Margin="12,0,28,0" Visibility="{Binding IsEventView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="60" /><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:T 时间}" Style="{StaticResource LogColumn}" />
                    <TextBlock Grid.Column="1" Text="{i18n:T 级别}" Style="{StaticResource LogColumn}" />
                    <TextBlock Grid.Column="2" Text="{i18n:T 来源}" Style="{StaticResource LogColumn}" />
                    <TextBlock Grid.Column="3" Text="{i18n:T 事件内容}" Style="{StaticResource LogColumn}" />
                </Grid>
                <ListBox x:Name="RequestList" Grid.Row="1" ItemsSource="{Binding RequestRows}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}"
                         Style="{StaticResource LogList}" ItemTemplate="{StaticResource RequestLogTemplate}"
                         Visibility="{Binding IsRequestView, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.AutomationId="RequestLogRows" />
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                         Style="{StaticResource LogList}" ItemTemplate="{StaticResource LogEventTemplate}"
                         Visibility="{Binding IsEventView, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.AutomationId="LogRows" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding EmptyText}" Margin="12,12,12,4" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{i18n:T 调整日期或清除筛选后再查看}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding Counter}" FontSize="12" VerticalAlignment="Center" AutomationProperties.AutomationId="LogCounter" />
                <TextBlock Text="{Binding CounterUnit}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{i18n:T 正在读取…}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{i18n:T 较新}" Command="{Binding NewerCommand}" IsEnabled="{Binding CanNewer}" Padding="10,5"
                           AutomationProperties.AutomationId="RuntimeLogsNewer" />
                <TextBlock Text="{Binding PageText}" Margin="10,0" VerticalAlignment="Center" FontSize="12" />
                <ui:Button Content="{i18n:T 较早}" Command="{Binding OlderCommand}" IsEnabled="{Binding CanOlder}" Padding="10,5"
                           AutomationProperties.AutomationId="RuntimeLogsOlder" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                       Visibility="{Binding IsEventView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Content="{i18n:T 复制原文}" Command="{Binding CopyEventCommand}" Style="{StaticResource LogChip}" />
                <ui:Button Content="{i18n:T 复制完整请求编号}" Command="{Binding CopyRequestCommand}" IsEnabled="{Binding CanCopyRequest}"
                           Style="{StaticResource LogChip}" AutomationProperties.AutomationId="CopyRuntimeRequestId" />
                <ui:Button Content="{i18n:T 查看请求诊断}" Command="{Binding OpenDiagnosticCommand}" IsEnabled="{Binding CanOpenDiagnostic}"
                           Style="{StaticResource LogChip}" AutomationProperties.AutomationId="OpenRuntimeDiagnostic" />
            </WrapPanel>
        </Grid>
    </Grid>
</Page>
