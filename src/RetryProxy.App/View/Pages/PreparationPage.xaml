<Page x:Class="RetryProxy.View.Pages.PreparationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="PreparationPage"
      d:DataContext="{d:DesignInstance Type=pages:PreparationPageViewModel}"
      d:DesignHeight="550"
      d:DesignWidth="700"
      FontFamily="{StaticResource TextThemeFontFamily}"
      FontSize="{StaticResource ControlContentThemeFontSize}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="PreparationCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{i18n:T 一键准备}" />
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           AutomationProperties.AutomationId="AddPreparation"
                           Command="{Binding AddPreparationCommand}"
                           Content="{i18n:T 新增准备}"
                           Icon="{ui:SymbolIcon Add24}" />
            </Grid>
            <controls:ClientSelector Margin="0,0,0,12" />
            <TextBlock Margin="0,0,0,4" Style="{StaticResource BodyTextBlockStyle}"
                       Text="{i18n:T 当前客户端的准备任务，准备成功后自动保活。}" TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,12"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{i18n:T 每项准备单独启停，设置会保存；重启软件后自动恢复退出时运行中的任务。}"
                       TextWrapping="Wrap" />

            <Border Style="{StaticResource PreparationCard}"
                    Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <StackPanel Margin="0,12">
                    <!--  空态图标沿用首页快捷卡片的“强调色图标 + 底色圆”样式  -->
                    <Border Width="48" Height="48" Margin="0,0,0,10" HorizontalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="24">
                        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Symbol="PlayCircle24"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{i18n:T 当前客户端尚未添加准备任务}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{i18n:T 点击“新增准备”为当前客户端添加任务。}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,0,0,8"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Summary}"
                       Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:PreparationGroupViewModel}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{Binding Title}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pages:PreparationTaskViewModel}">
                                        <Border Style="{StaticResource PreparationCard}" AutomationProperties.AutomationId="{Binding Id}"
                                                ToolTip="{Binding Hint}" AutomationProperties.HelpText="{Binding Hint}">
                                            <StackPanel>
                                                <!-- 一项任务一行，今日计数和失败原因放到悬停提示中。 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="1.7*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" />
                                                                <TextBlock Text="{Binding ProviderUrl}" />
                                                                <TextBlock Text="{Binding Statistics}" />
                                                            </StackPanel>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Hint}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  状态圆点：已准备绿、准备中强调色、失败红、其余保持灰色  -->
                                                        <Border Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPreparing}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <ui:ProgressRing Grid.Column="1" Width="12" Height="12" Margin="0,0,4,0"
                                                                         IsIndeterminate="{Binding IsPreparing}"
                                                                         Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <!--  状态文字同色：已准备绿、准备中强调色、失败红  -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                                                   AutomationProperties.AutomationId="{Binding StatusAutomationId}"
                                                                   AutomationProperties.HelpText="{Binding Hint}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPreparing}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Settings}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Settings}" />
                                                                <TextBlock Text="{Binding Statistics}" />
                                                            </StackPanel>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Margin="0,0,6,0" Padding="8,4" Appearance="Primary"
                                                                   Command="{Binding DataContext.StartPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding Id}" Content="{i18n:T 开始}" AutomationProperties.Name="{i18n:T 开始}"
                                                                   AutomationProperties.AutomationId="{Binding StartAutomationId}"
                                                                   ToolTip="{i18n:T 开始准备}"
                                                                   Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <ui:Button Margin="0,0,6,0" Padding="8,4"
                                                                   Command="{Binding DataContext.StopPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding Id}" Content="{i18n:T 停止}" AutomationProperties.Name="{i18n:T 停止}"
                                                                   AutomationProperties.AutomationId="{Binding StopAutomationId}"
                                                                   ToolTip="{Binding StopText}"
                                                                   Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <ui:Button Margin="0,0,6,0" Padding="8,4"
                                                                   Command="{Binding DataContext.EditPreparationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding Id}" Content="{i18n:T 修改}"
                                                                   Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   IsEnabled="{Binding CanStart}" />
                                                        <ui:Button Click="OnTaskMenuClick" Padding="6,4" Content="⋯"
                                                                           AutomationProperties.Name="{i18n:T 任务操作}"
                                                                           AutomationProperties.AutomationId="{Binding MenuAutomationId}"
                                                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                                            <ui:Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                             Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Header="{i18n:T 修改}"
                                                                              Command="{Binding Tag.EditPreparationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Id}" IsEnabled="{Binding CanStart}" />
                                                                    <MenuItem Header="{i18n:T 删除}"
                                                                              Command="{Binding Tag.RemovePreparationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Id}" IsEnabled="{Binding CanStart}" />
                                                                    <MenuItem Header="{i18n:T 查看日志}"
                                                                              Command="{Binding Tag.ViewPreparationLogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding Id}" />
                                                                </ContextMenu>
                                                            </ui:Button.ContextMenu>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
