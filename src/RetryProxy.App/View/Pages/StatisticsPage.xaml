<Page x:Class="RetryProxy.View.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:RetryProxy.View.Pages"
      Title="StatisticsPage" FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{i18n:T 统计}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{i18n:T 请求、用量与费用，一目了然}" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Content="{i18n:T 模型单价}" Command="{Binding Overview.OpenPricesCommand}" Padding="12,7" Margin="0,0,8,0" AutomationProperties.AutomationId="StatisticsOpenPrices" />
                    <ui:Button Content="{i18n:T 刷新}" Command="{Binding Overview.RefreshCommand}" Padding="12,7" AutomationProperties.AutomationId="StatisticsRefresh" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,0,0,18">
                <ui:Button Content="{i18n:T 用量分析}" Command="{Binding SelectTabCommand}" CommandParameter="overview" Padding="14,7" Margin="0,0,6,0"
                           Appearance="{Binding IsOverview, Converter={StaticResource BooleanToChipAppearanceConverter}}" AutomationProperties.AutomationId="StatisticsTabOverview" />
                <ui:Button Content="{i18n:T 缓存详情}" Command="{Binding SelectTabCommand}" CommandParameter="cache" Padding="14,7" Margin="0,0,6,0"
                           Appearance="{Binding IsCache, Converter={StaticResource BooleanToChipAppearanceConverter}}" AutomationProperties.AutomationId="StatisticsTabCache" />
                <ui:Button Content="{i18n:T 实时请求}" Command="{Binding SelectTabCommand}" CommandParameter="active" Padding="14,7"
                           Appearance="{Binding IsActive, Converter={StaticResource BooleanToChipAppearanceConverter}}" AutomationProperties.AutomationId="StatisticsTabActive" />
            </WrapPanel>
            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityRevertConverter}}" Margin="0,0,0,14">
                <controls:ClientSelector Margin="0,0,0,12" />
                <Grid Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentProviderKey}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentProviderKey}" AutomationProperties.AutomationId="StatisticsCurrentProviderKey" />
                        <TextBlock Text="{Binding DateCaption}" ToolTip="{Binding DateHelp}" Foreground="{Binding DateCaptionBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <ui:InfoBadge Grid.Column="1" VerticalAlignment="Center" Value="{Binding StateLabel}" Severity="{Binding StateSeverity}" />
                </Grid>
                <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
            </StackPanel>
            <Grid Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:OverviewPage DataContext="{Binding Overview}" />
            </Grid>
            <Grid Visibility="{Binding IsCache, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:CachePage DataContext="{Binding Cache}" />
            </Grid>
            <Grid Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:ActiveRequestsPage DataContext="{Binding Active}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
