<Page x:Class="RetryProxy.View.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="HomePage"
      d:DataContext="{d:DesignInstance Type=pages:HomePageViewModel}"
      d:DesignHeight="850"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <StackPanel Margin="42,16,42,12">

        <!--  横幅  -->
        <Border Height="200" CornerRadius="8">
            <Grid>
                <Border ClipToBounds="True" CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BannerImageSource}"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="Transparent" />
                            <GradientStop Offset="0.7" Color="White" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Grid>
                    <StackPanel Margin="52,0,0,26"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="Transparent">
                        <ui:TextBlock FontTypography="Title" Text="LLM Retry Proxy" />
                        <ui:TextBlock FontTypography="Subtitle"
                                      Opacity="0.8"
                                      Text="{i18n:T 本地 LLM 反向代理，自动重试，免费且开源}" />
                        <ui:TextBlock FontTypography="BodyStrong" Opacity="0.5">
                            <Hyperlink Command="{Binding GoToWikiUrlCommand}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextDecorations="None">
                                <Run Text="{i18n:T 点击查看文档与教程}" />
                                <Run FontFamily="{StaticResource FluentSystemIcons}" FontWeight="Light">&#xEE7A;</Run>
                            </Hyperlink>
                        </ui:TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  代理服务，启动！  -->
        <ui:CardExpander Margin="0,12,0,12"
                         ContentPadding="0"
                         Icon="{ui:SymbolIcon Play24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 代理服务，启动！}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  TextWrapping="Wrap">
                        <Run Text="{i18n:T 服务启动后本地端口才会开始转发请求，}" /><Run FontWeight="Bold"
                                                                                       Text="{i18n:T 点击展开启动相关配置}"
                                                                                       TextDecorations="Underline" /><Run Text="{i18n:T 。}" />
                    </ui:TextBlock>
                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Margin="0,0,24,0"
                                Orientation="Horizontal">
                        <controls:TwoStateButton DisableCommand="{Binding StopProxyCommand}"
                                                 DisableContent="{i18n:T 停止}"
                                                 DisableIcon="{ui:SymbolIcon Dismiss24}"
                                                 EnableCommand="{Binding StartProxyCommand}"
                                                 EnableContent="{i18n:T 启动}"
                                                 EnableIcon="{ui:SymbolIcon Play24}"
                                                 IsChecked="{Binding IsProxyRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 服务商}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{i18n:T 选择上游服务商，通道将转发到该服务商的基础地址}"
                                  TextWrapping="Wrap" />
                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Margin="0,0,36,0"
                                Orientation="Horizontal">
                        <ComboBox MinWidth="220"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Text"
                                  ItemsSource="{Binding Providers, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" />
                        <ui:Button Margin="6,0,0,0"
                                   Command="{Binding AddProviderCommand}"
                                   Icon="{ui:SymbolIcon Add24}"
                                   ToolTip="{i18n:T 新增服务商}" />
                        <ui:Button Margin="4,0,0,0"
                                   Command="{Binding EditProviderCommand}"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   IsEnabled="{Binding HasProvider}"
                                   ToolTip="{i18n:T 编辑服务商}" />
                        <ui:Button Margin="4,0,0,0"
                                   Command="{Binding DeleteProviderCommand}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   IsEnabled="{Binding HasProvider}"
                                   ToolTip="{i18n:T 删除服务商}" />
                    </StackPanel>
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 通道}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  TextWrapping="Wrap">
                        <Run Text="{i18n:T 每个通道占用一个本地端口，可独立启停}" /><Run Text=" · " /><Run Text="{Binding ProviderUsage, Mode=OneWay}" />
                    </ui:TextBlock>
                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Margin="0,0,36,0"
                                Orientation="Horizontal">
                        <ComboBox MinWidth="220"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{i18n:T 通道选择}"
                                  DisplayMemberPath="Text"
                                  IsEnabled="{Binding HasChannel}"
                                  ItemsSource="{Binding Channels, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" />
                        <ui:Button Margin="6,0,0,0"
                                   Command="{Binding AddChannelCommand}"
                                   Icon="{ui:SymbolIcon Add24}"
                                   IsEnabled="{Binding HasProvider}"
                                   ToolTip="{i18n:T 新增通道}" />
                        <ui:Button Margin="4,0,0,0"
                                   Command="{Binding EditChannelCommand}"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   IsEnabled="{Binding CanEditChannel}"
                                   ToolTip="{Binding ChannelEditToolTip}"
                                   ToolTipService.ShowOnDisabled="True" />
                        <ui:Button Margin="4,0,0,0"
                                   Command="{Binding DeleteChannelCommand}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   IsEnabled="{Binding CanEditChannel}"
                                   ToolTip="{Binding ChannelEditToolTip}"
                                   ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </Grid>
                <ui:TextBlock Margin="16,0,16,12"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="{Binding EmptyHint}"
                              TextWrapping="Wrap"
                              Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 本地监听端口}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{i18n:T 默认 8080，后续通道依次递增}"
                                  TextWrapping="Wrap" />
                    <ui:TextBox Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                MinWidth="90"
                                Margin="0,0,36,0"
                                IsEnabled="{Binding HasChannel}"
                                IsReadOnly="{Binding IsProxyRunning}"
                                Text="{Binding ListenPort, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 本通道保活}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{i18n:T 空闲超过设定分钟数后自动发送保活请求，避免上游会话过期}"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,10,0"
                                     AutomationProperties.Name="{i18n:T 本通道保活}"
                                     IsChecked="{Binding KeepAliveEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding HasChannel}" />
                    <ui:Button Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="2"
                               Margin="0,0,36,0"
                               Command="{Binding PrepareKeepAliveCommand}"
                               Content="{i18n:T 一键准备}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="{i18n:T 本地监听地址}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding ListenAddress, Mode=OneWay}"
                                  TextWrapping="Wrap" />
                    <ui:Button Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="1"
                               Margin="0,0,36,0"
                               Command="{Binding CopyListenAddressCommand}"
                               Content="{i18n:T 复制}"
                               Icon="{ui:SymbolIcon Copy24}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

    </StackPanel>
</Page>
