<Page x:Class="RetryProxy.View.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="OverviewPage"
      d:DataContext="{d:DesignInstance Type=pages:OverviewPageViewModel}"
      d:DesignHeight="900"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{i18n:T 运行概况}" />
                <ui:Button Grid.Column="1"
                           AutomationProperties.AutomationId="ManageChannels"
                           Command="{Binding ManageChannelsCommand}"
                           Content="{i18n:T 通道管理}"
                           Icon="{ui:SymbolIcon Channel24}" />
            </Grid>

            <!--  所有通道的运行概况  -->
            <ui:Card Margin="0,0,0,12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0"
                                  AutomationProperties.AutomationId="OverviewRunningSummary"
                                  FontTypography="Body"
                                  Foreground="{Binding RunningBrush}"
                                  Text="{Binding RunningSummary}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding VersionText}" />
                </Grid>
            </ui:Card>

            <!--  跨服务商查看通道，与通道管理、缓存页同步所选通道  -->
            <ui:Card Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <TextBlock Margin="0,0,0,6" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{i18n:T 当前通道}" />
                    <Grid Visibility="{Binding HasChannels, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox MinWidth="0"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="OverviewChannelPicker"
                                  AutomationProperties.Name="{i18n:T 通道选择}"
                                  ItemsSource="{Binding Channels}"
                                  SelectedItem="{Binding SelectedChannel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <ui:InfoBadge Grid.Column="1" Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Severity="{Binding StateSeverity}"
                                      Value="{Binding StateLabel}"
                                      Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding EmptyHint}" TextWrapping="Wrap"
                               Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,0,12" Padding="14,8" Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Margin="0,0,16,0" FontTypography="Body" Text="{i18n:T 保活状态}" />
                    <ui:TextBlock Grid.Column="1"
                                  FontSize="11"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Hint}"
                                  TextWrapping="Wrap"
                                  ToolTip="{Binding HintToolTip}" />
                </Grid>
            </ui:Card>
            <!--  今日统计  -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!--  本地监听 + 日期说明  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Padding="10,6"
                                   Command="{Binding CopyLocalUrlCommand}"
                                   ToolTip="{i18n:T 点击复制}">
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{Binding CopyLabelBrush}"
                                           Text="{Binding CopyLabel}" />
                                <TextBlock AutomationProperties.AutomationId="OverviewLocalUrl"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Text="{Binding LocalUrl}" />
                            </StackPanel>
                        </ui:Button>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{Binding DateCaptionBrush}"
                                   Text="{Binding DateCaption}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DateHelp}" />
                    </Grid>

                    <!--  五个统计瓦片  -->
                    <UniformGrid Margin="0,12,-8,0" Columns="5">
                        <Border Style="{StaticResource TileBorder}">
                            <StackPanel>
                                <TextBlock AutomationProperties.AutomationId="OverviewTotalRequests" Style="{StaticResource TileValue}" Text="{Binding TotalRequests}" />
                                <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 今日请求}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Style="{StaticResource TileValue}"
                                           Text="{Binding SuccessfulRequests}" />
                                <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 成功}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Style="{StaticResource TileValue}"
                                           Text="{Binding RetryCount}" />
                                <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 重试}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource TileValue}"
                                           Text="{Binding FailedRequests}" />
                                <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 失败}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource TileValue}"
                                           Text="{Binding ActiveRequests}" />
                                <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 用户处理中}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!--  缓存摘要  -->
                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding RateHelp}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{i18n:T 今日缓存命中}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding HitRateBrush}"
                                               Text="{Binding HitRateText}" />
                                </StackPanel>
                                <ProgressBar Height="5"
                                             Margin="0,4,0,4"
                                             Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                             Maximum="100"
                                             ToolTip="{Binding HitRateHelp}"
                                             Value="{Binding HitRateProgress, Mode=OneWay}" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding CreationText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CreationHelp}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding LatestHelp}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{i18n:T 最近一次成功}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding LatestBrush}"
                                               Text="{Binding LatestText}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding LatestDetail}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ZeroHitHelp}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{i18n:T 完全未命中}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding ZeroHitBrush}"
                                               Text="{Binding ZeroHitText}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding MeasuredText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RateHelp}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  请求明细  -->
                    <ScrollViewer MaxHeight="66"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Text="{Binding RequestId}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Attempt}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{Binding PhaseBrush}"
                                                   Text="{Binding Phase}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding Target}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Target}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
