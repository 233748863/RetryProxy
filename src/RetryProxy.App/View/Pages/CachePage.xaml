<Page x:Class="RetryProxy.View.Pages.CachePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="CachePage"
      d:DataContext="{d:DesignInstance Type=pages:CachePageViewModel}"
      d:DesignHeight="700"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WeakText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <!--  标题 + 通道选择  -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <ComboBox Grid.Column="1"
                          MinWidth="220"
                          DisplayMemberPath="Text"
                          ItemsSource="{Binding Channels}"
                          SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                          ToolTip="{i18n:T 与首页选中的通道保持同步}"
                          Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{i18n:T 请先新增服务商与通道，收到成功回复后这里会显示缓存记录}"
                       Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />

            <ui:Card Padding="14" Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!--  行 1：今日命中  -->
                    <WrapPanel>
                        <TextBlock Style="{StaticResource WeakText}" Text="{Binding DateHeadline}" />
                        <TextBlock Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{Binding HitRateBrush}"
                                   Text="{Binding HitRateText}"
                                   ToolTip="{Binding RateHelp}" />
                        <TextBlock Style="{StaticResource WeakText}"
                                   Text="{Binding TokensText}"
                                   ToolTip="{Binding TokensHelp}" />
                        <TextBlock Margin="6,0,0,0"
                                   Style="{StaticResource WeakText}"
                                   Text="{Binding CreationText}"
                                   ToolTip="{Binding CreationHelp}" />
                    </WrapPanel>

                    <!--  行 2：最近 n 次  -->
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock FontSize="11.5"
                                   Text="{Binding RecentSummary}"
                                   ToolTip="{Binding RateHelp}" />
                        <TextBlock Margin="8,0,0,0"
                                   FontSize="10.5"
                                   Style="{StaticResource WeakText}"
                                   Text="{i18n:T 从旧到新 →}" />
                    </WrapPanel>

                    <!--  走势图：20 个槽位  -->
                    <Grid Height="56" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Trend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="20" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0" ToolTip="{Binding ToolTip}">
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" />
                                        <Border Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding Brush}"
                                                CornerRadius="3"
                                                Visibility="{Binding IsMeasured, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="×"
                                                   Visibility="{Binding IsUnmeasured, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{i18n:T 暂无成功请求}"
                                   Visibility="{Binding TrendIsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <!--  图例  -->
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock FontSize="10.5"
                                   Foreground="{Binding HitBrush}"
                                   Text="{i18n:T 有命中}" />
                        <TextBlock Margin="8,0,0,0"
                                   FontSize="10.5"
                                   Foreground="{Binding ZeroHitBrush}"
                                   Text="{i18n:T 完全未命中}" />
                        <TextBlock Margin="8,0,0,0"
                                   FontSize="10.5"
                                   Style="{StaticResource WeakText}"
                                   Text="{i18n:T 未计入}" />
                        <TextBlock Margin="8,0,0,0"
                                   FontSize="10.5"
                                   Style="{StaticResource WeakText}"
                                   Text="{Binding LegendCounts}"
                                   ToolTip="{Binding UsageHelp}" />
                    </WrapPanel>

                    <Separator Margin="0,10,0,8" />

                    <!--  筛选  -->
                    <WrapPanel>
                        <ui:Button Margin="0"
                                   Appearance="{Binding IsAll, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                                   Command="{Binding SetFilterCommand}"
                                   CommandParameter="all"
                                   Content="{i18n:T 全部}"
                                   Style="{StaticResource ChipButton}" />
                        <ui:Button Appearance="{Binding IsZeroHit, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                                   Command="{Binding SetFilterCommand}"
                                   CommandParameter="zero-hit"
                                   Content="{i18n:T 完全未命中}"
                                   Style="{StaticResource ChipButton}" />
                        <ui:Button Appearance="{Binding IsUnmeasured, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                                   Command="{Binding SetFilterCommand}"
                                   CommandParameter="unmeasured"
                                   Content="{i18n:T 未计入}"
                                   Style="{StaticResource ChipButton}" />
                        <TextBlock Margin="10,0,0,0"
                                   FontSize="10.5"
                                   Style="{StaticResource WeakText}"
                                   Text="{i18n:T 最新在前}" />
                    </WrapPanel>

                    <!--  表头  -->
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 完成时间 / 请求}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="{i18n:T 模型}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="{i18n:T 缓存命中率}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnLabel}" Text="{i18n:T 读取 / 总输入 token}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnLabel}" Text="{i18n:T 缓存写入 token}" />
                    </Grid>

                    <!--  表体  -->
                    <ScrollViewer MaxHeight="252"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Time}" />
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{i18n:T 点击复制请求编号，可在日志文件中查找}">
                                                <Hyperlink Command="{Binding DataContext.CopyRequestIdCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding RequestId}"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           TextDecorations="None">
                                                    <Run Text="{Binding RequestId, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding Model}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Model}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding RateBrush}"
                                                   Text="{Binding Rate}"
                                                   ToolTip="{Binding Hint}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding Usage}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding UsageHelp}" />
                                        <TextBlock Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding Creation}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Hint}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding EmptyRowsText}"
                               Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />

                    <!--  统计范围  -->
                    <ui:CardExpander Margin="0,12,0,0"
                                     ContentPadding="16,10"
                                     Icon="{ui:SymbolIcon Info24}">
                        <ui:CardExpander.Header>
                            <ui:TextBlock FontTypography="Body" Text="{i18n:T 统计范围}" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpText}" Text="{Binding RateHelp}" />
                            <TextBlock Style="{StaticResource HelpText}" Text="{Binding UsageHelp}" />
                            <TextBlock Style="{StaticResource HelpText}" Text="{Binding ClaudeHelp}" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="{Binding CacheKeyHelp}"
                                       Visibility="{Binding HasCacheKeyHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
