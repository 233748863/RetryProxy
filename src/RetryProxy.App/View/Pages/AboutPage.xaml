<Page x:Class="RetryProxy.View.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      Title="AboutPage"
      d:DataContext="{d:DesignInstance Type=pages:AboutPageViewModel}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{i18n:T 关于}" />

            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Info24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="{Binding Headline}" TextWrapping="Wrap" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
