<Application x:Class="RetryProxy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behavior="clr-namespace:RetryProxy.View.Behavior"
             xmlns:conv="clr-namespace:RetryProxy.View.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <vio:ControlsDictionary />
                <ResourceDictionary Source="/View/Controls/Style/ListViewEx.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 字体 ===== -->
            <FontFamily x:Key="TextThemeFontFamily">/Resources/Fonts/MiSans-Regular.ttf#MiSans</FontFamily>
            <FontFamily x:Key="DigitalThemeFontFamily">/Resources/Fonts/deluge-led.ttf#Deluge LED</FontFamily>

            <!-- ===== 设计令牌 ===== -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <Thickness x:Key="PagePadding">48,20,48,28</Thickness>

            <!-- ===== 全局 Converter ===== -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:BooleanToVisibilityRevertConverter x:Key="BooleanToVisibilityRevertConverter" />
            <conv:BooleanToEnableTextConverter x:Key="BooleanToEnableTextConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <conv:NotNullConverter x:Key="NotNullConverter" />
            <conv:EnumToKVPConverter x:Key="EnumToKVPConverter" />
            <conv:CultureInfoNameToKVPConverter x:Key="CultureInfoNameToKVPConverter" />
            <conv:StringToColorConverter x:Key="StringToColorConverter" />
            <conv:AdaptiveUniformGridColumnsConverter x:Key="AdaptiveUniformGridColumnsConverter" />
            <conv:MillisecondsToTimeConverter x:Key="MillisecondsToTimeConverter" />
            <conv:BooleanToChipAppearanceConverter x:Key="BooleanToChipAppearanceConverter" />

            <!-- ===== 全局 TextBox 安全剪贴板 ===== -->
            <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="{x:Type TextBox}">
                <Setter Property="behavior:ClipboardInterceptor.EnableSafeClipboard" Value="True" />
            </Style>
            <Style BasedOn="{StaticResource DefaultUiTextBoxStyle}" TargetType="{x:Type ui:TextBox}">
                <Setter Property="behavior:ClipboardInterceptor.EnableSafeClipboard" Value="True" />
            </Style>
            <!--  日志页/缓存页的筛选小圆角按钮  -->
            <Style x:Key="ChipButton"
                   BasedOn="{StaticResource {x:Type ui:Button}}"
                   TargetType="ui:Button">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
