<ui:ContentDialog x:Class="RetryProxy.View.Dialogs.PrepareOptionsDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:behavior="clr-namespace:RetryProxy.View.Behavior"
                  Title="{i18n:T 一键准备}"
                  CloseButtonText="{i18n:T 取消}"
                  DefaultButton="Primary"
                  DialogMaxWidth="560"
                  FontFamily="{StaticResource TextThemeFontFamily}"
                  Style="{DynamicResource {x:Type ui:ContentDialog}}"
                  PrimaryButtonText="{i18n:T 开始准备}">
    <StackPanel MinWidth="460">
        <ui:TextBlock x:Name="SubtitleText"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      TextWrapping="Wrap" />

        <RadioButton x:Name="CurrentRadio"
                     Margin="0,14,0,0"
                     Checked="OnModeChanged"
                     Content="{i18n:T 使用本通道供应商准备}"
                     GroupName="prepare-mode"
                     IsChecked="True" />
        <RadioButton x:Name="NewRadio"
                     Margin="0,10,0,0"
                     Checked="OnModeChanged"
                     Content="{i18n:T 配置新供应商准备}"
                     GroupName="prepare-mode" />
        <StackPanel Margin="28,2,0,0">
            <StackPanel x:Name="NewProviderPanel">
                <ui:TextBlock Margin="0,8,0,4" Text="{i18n:T 准备客户端}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NewCodexRadio"
                                 Checked="OnClientChanged"
                                 Content="Codex"
                                 GroupName="prepare-client" />
                    <RadioButton x:Name="NewClaudeRadio"
                                 Margin="16,0,0,0"
                                 Checked="OnClientChanged"
                                 Content="Claude Code"
                                 GroupName="prepare-client" />
                </StackPanel>
                <ui:TextBlock Margin="0,8,0,4" Text="{i18n:T 新供应商地址}" />
                <ui:TextBox x:Name="NewProviderUrlBox"
                            behavior:ClipboardInterceptor.EnableUrlPaste="True"
                            PlaceholderText="https://api.example.com"
                            TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel x:Name="NewProviderKeyPanel">
                <ui:TextBlock Margin="0,8,0,4" Text="API Key" />
                <ui:PasswordBox x:Name="ApiKeyBox"
                                PasswordChanged="OnFieldChanged"
                                PlaceholderText="sk-…"
                                RevealButtonEnabled="True"
                                ToolTip="{i18n:T 密钥只保留在本次运行的内存中，重启后清空。}" />
            </StackPanel>
            <ui:TextBlock Margin="0,8,0,4" Text="{i18n:T 准备模型}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelBox"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          SelectionChanged="OnModelChanged"
                          ToolTip="{i18n:T 可输入或粘贴模型名称，也可获取后选择}" />
                <ui:Button x:Name="FetchModelsButton"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Click="OnFetchModels"
                           Content="{i18n:T 获取模型}" />
            </Grid>
            <ui:TextBlock x:Name="ModelsLoadingText"
                          Margin="0,6,0,0"
                          Text="{i18n:T 正在获取模型…}"
                          Visibility="Collapsed" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:TextBlock VerticalAlignment="Center" Text="{i18n:T 独立保活间隔}" />
                <ui:TextBox x:Name="IdleMinutesBox"
                            Width="72"
                            Margin="12,0,6,0"
                            ToolTip="{i18n:T 允许输入 0.5～1440 分钟}" />
                <ui:TextBlock VerticalAlignment="Center" Text="{i18n:T 分钟}" />
            </StackPanel>
            <ui:TextBlock Margin="0,4,0,0"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="{i18n:T 准备成功后按此间隔保活；仅在本次运行有效}" />
            <ui:TextBlock x:Name="PlanText"
                          Margin="0,8,0,0"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap" />
        </StackPanel>

        <ui:TextBlock x:Name="ErrorText"
                      Margin="0,10,0,0"
                      Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                      TextWrapping="Wrap"
                      Visibility="Collapsed" />
    </StackPanel>
</ui:ContentDialog>
