<UserControl x:Class="RetryProxy.View.Pages.ActiveRequestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=pages:ActiveRequestsViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="700"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ui:Card Padding="14" Visibility="{Binding HasChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{i18n:T 在途请求}" />
                <TextBlock Margin="0,0,0,10"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{i18n:T 当前实际处理中的请求；已完成的历史请求请查看请求诊断。}"
                           TextWrapping="Wrap" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 请求编号}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="{i18n:T 次数}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="{i18n:T 阶段}" />
                    <TextBlock Grid.Column="3" Margin="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 目标}" />
                </Grid>

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding RequestId}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Attempt}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{Binding PhaseBrush}"
                                               Text="{Binding Phase}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Target}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Target}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{i18n:T 当前没有处理中的请求}"
                           Visibility="{Binding HasRequests, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
