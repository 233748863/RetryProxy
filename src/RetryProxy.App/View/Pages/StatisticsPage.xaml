<Page x:Class="RetryProxy.View.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:views="clr-namespace:RetryProxy.View.Pages"
      Title="StatisticsPage"
      d:DataContext="{d:DesignInstance Type=pages:StatisticsPageViewModel}"
      d:DesignHeight="900"
      d:DesignWidth="800"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <!-- 两个分区共用页面滚动和客户端选择，保留原统计图、瓦片、明细及其筛选逻辑。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="{i18n:T 统计}" />
            <controls:ClientSelector Margin="0,0,0,12" />
            <views:OverviewPage DataContext="{Binding Overview}" />
            <views:CachePage DataContext="{Binding Cache}" />
        </StackPanel>
    </ScrollViewer>
</Page>
