<Page x:Class="RetryProxy.View.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="LogPage"
      d:DataContext="{d:DesignInstance Type=pages:LogPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="LogFilterChip" BasedOn="{StaticResource ChipButton}" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="LogRowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Selection" Background="Transparent"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="48,20,48,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  来源和级别分行；窄窗口下筛选项自动换行。  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <controls:ClientSelector Margin="0,0,0,12" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{i18n:T 运行日志}" />
                    <TextBlock Margin="8,2,0,0"
                               AutomationProperties.AutomationId="LogCounter"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Counter}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="{i18n:T 自动滚动}"
                              IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              ToolTip="{Binding AutoScrollToolTip}" />
                    <ui:Button Command="{Binding OpenDirectoryCommand}"
                               Content="{i18n:T 打开目录}"
                               Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button Margin="8,0,0,0"
                               Command="{Binding ClearCommand}"
                               IsEnabled="{Binding CanUseRows}"
                               Content="{i18n:T 清空显示}"
                               Icon="{ui:SymbolIcon Broom24}" />
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="{i18n:T 日期}" VerticalAlignment="Center" Margin="0,0,8,6" />
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" DisplayDateStart="{Binding EarliestDate}"
                            DisplayDateEnd="{Binding LatestDate}" SelectedDateFormat="Short" Width="150" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="RuntimeLogDate" />
                <ui:Button Content="{i18n:T 今天}" Command="{Binding TodayCommand}" Margin="0,0,8,6" />
                <ui:Button Content="{i18n:T 刷新}" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
                <ui:Button Content="{i18n:T 导出筛选结果}" Command="{Binding ExportCommand}" Margin="0,0,8,6"
                           IsEnabled="{Binding CanUseRows}"
                           AutomationProperties.AutomationId="ExportRuntimeLogs" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,2">
                <TextBlock Margin="0,0,8,6"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{i18n:T 来源}" />
                <ui:Button Appearance="{Binding IsAllSources, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                           AutomationProperties.AutomationId="LogSourceAll"
                           Command="{Binding SetSourceCommand}"
                           CommandParameter="all"
                           Content="{i18n:T 全部}"
                           Style="{StaticResource LogFilterChip}" />
                <ui:Button Appearance="{Binding IsChannelProxy, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                           AutomationProperties.AutomationId="LogSourceProxy"
                           Command="{Binding SetSourceCommand}"
                           CommandParameter="proxy"
                           Content="{i18n:T 通道代理}"
                           Style="{StaticResource LogFilterChip}"
                           ToolTip="{i18n:T 通道的请求转发、重试和服务启停}" />
                <ui:Button Appearance="{Binding IsChannelKeepAlive, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                           AutomationProperties.AutomationId="LogSourceKeepAlive"
                           Command="{Binding SetSourceCommand}"
                           CommandParameter="keepalive"
                           Content="{i18n:T 通道保活}"
                           Style="{StaticResource LogFilterChip}"
                           ToolTip="{i18n:T 通道的后台问答与自动保活}" />
                <ui:Button Appearance="{Binding IsPreparation, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                           AutomationProperties.AutomationId="LogSourcePreparation"
                           Command="{Binding SetSourceCommand}"
                           CommandParameter="preparation"
                           Content="{i18n:T 一键准备}"
                           Style="{StaticResource LogFilterChip}"
                           ToolTip="{i18n:T 独立任务的准备、重试、独立保活和启停全过程}" />
                <ui:Button Appearance="{Binding IsSystem, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                           AutomationProperties.AutomationId="LogSourceSystem"
                           Command="{Binding SetSourceCommand}"
                           CommandParameter="system"
                           Content="{i18n:T 系统}"
                           Style="{StaticResource LogFilterChip}" />
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,6"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{i18n:T 级别}" />
                    <ui:Button
                               Appearance="{Binding IsAll, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               AutomationProperties.AutomationId="LogLevelAll"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="all"
                               Content="{i18n:T 全部}"
                               Style="{StaticResource LogFilterChip}" />
                    <ui:Button Appearance="{Binding IsInfo, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="info"
                               Content="{i18n:T 信息}"
                               Style="{StaticResource LogFilterChip}" />
                    <ui:Button Appearance="{Binding IsWarning, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               AutomationProperties.AutomationId="LogLevelWarning"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="warning"
                               Content="{i18n:T 警告}"
                               Style="{StaticResource LogFilterChip}" />
                    <ui:Button Appearance="{Binding IsError, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               Command="{Binding SetFilterCommand}"
                               CommandParameter="error"
                               Content="{i18n:T 错误}"
                               Style="{StaticResource LogFilterChip}" />
                    <ui:Button Appearance="{Binding OnlySelected, Converter={StaticResource BooleanToChipAppearanceConverter}}"
                               AutomationProperties.AutomationId="LogSelectedClient"
                               Command="{Binding ToggleOnlySelectedCommand}"
                               Style="{StaticResource LogFilterChip}"
                               ToolTip="{Binding OnlySelectedLabel}"
                               Visibility="{Binding ShowClientFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{i18n:T 仅当前客户端}" />
                    </ui:Button>
                </WrapPanel>
                <ui:TextBox Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="LogSearch"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{i18n:T 搜索任务 / 客户端 / 请求 ID}"
                            Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </Grid>
        </StackPanel>

        <!--  日志列表  -->
        <TextBlock Grid.Row="1" Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Border Grid.Row="2"
                Padding="9,6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid ClipToBounds="True">
                <ListBox x:Name="LogList"
                         AutomationProperties.AutomationId="LogRows"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogRowStyle}"
                         ItemsSource="{Binding Rows}"
                         SelectedIndex="{Binding SelectedRowIndex, Mode=TwoWay}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:LogLineTextBlock AutomationProperties.Name="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Line="{Binding}"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="4"
                           VerticalAlignment="Top"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           IsHitTestVisible="False"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <ui:Button Content="{i18n:T 较新一页}" Command="{Binding NewerCommand}" IsEnabled="{Binding CanNewer}"
                       AutomationProperties.AutomationId="RuntimeLogsNewer" Margin="0,0,8,6" />
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="0,0,8,6" />
            <ui:Button Content="{i18n:T 较早一页}" Command="{Binding OlderCommand}" IsEnabled="{Binding CanOlder}"
                       AutomationProperties.AutomationId="RuntimeLogsOlder" Margin="0,0,16,6" />
            <ui:Button Content="{i18n:T 复制完整请求编号}" Command="{Binding CopyRequestCommand}" IsEnabled="{Binding CanCopyRequest}" Margin="0,0,8,6"
                       AutomationProperties.AutomationId="CopyRuntimeRequestId" />
            <ui:Button Content="{i18n:T 查看请求诊断}" Command="{Binding OpenDiagnosticCommand}" IsEnabled="{Binding CanOpenDiagnostic}" Margin="0,0,0,6"
                       AutomationProperties.AutomationId="OpenRuntimeDiagnostic" />
        </WrapPanel>
    </Grid>
</Page>
