<Page x:Class="RetryProxy.View.Pages.ProviderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RetryProxy.View.Controls"
      xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource TextThemeFontFamily}" Title="ProviderPage">
    <Page.Resources>
        <Style x:Key="ProviderCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Padding" Value="12" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,28">
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:ClientSelector />
                <ui:Button Grid.Column="1" Content="{i18n:T 新增供应商}" Command="{Binding AddProviderCommand}" Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}" AutomationProperties.AutomationId="AddProvider" />
            </Grid>
            <ui:TextBox Margin="0,0,0,12" PlaceholderText="{i18n:T 搜索名称、地址、Key 名或备注}" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        Visibility="{Binding ShowSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ui:Card Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="●" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="ProxyState" />
                        <TextBlock Text="{Binding Address}" Margin="10,0,6,0" VerticalAlignment="Center" FontFamily="Consolas" AutomationProperties.AutomationId="ProviderLocalUrl" />
                        <ui:Button Content="{i18n:T 复制}" Padding="7,3" Command="{Binding CopyAddressCommand}" />
                        <ui:Button Content="{i18n:T 启动}" Margin="8,0,0,0" Padding="7,3" Command="{Binding StartProxyCommand}" AutomationProperties.AutomationId="StartProxy"
                                   Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StateReason}" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{i18n:T 当前：}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentKey}" VerticalAlignment="Center" FontWeight="SemiBold" MaxWidth="340" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentKey}" AutomationProperties.AutomationId="CurrentProviderKey" />
                        <ui:Button Content="{i18n:T 定位}" Margin="8,0,0,0" Padding="7,3" Command="{Binding LocateCommand}" IsEnabled="{Binding HasCurrentProvider}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Today}" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                        <ui:ToggleSwitch Content="{i18n:T 保活}" IsChecked="{Binding KeepAliveEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="ChannelKeepAlive" />
                        <ui:Button Content="{i18n:T 代理设置}" Command="{Binding ProxySettingsCommand}" Margin="12,0,0,0" Padding="8,4" AutomationProperties.AutomationId="ProxySettings" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{i18n:T 客户端：}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClientState}" VerticalAlignment="Center" ToolTip="{Binding ClientError}" AutomationProperties.AutomationId="ClientState" />
                        <ui:Button Content="{Binding ClientActionText}" Command="{Binding TakeOverClientCommand}" Margin="8,0,0,0" Padding="8,4"
                                   IsEnabled="{Binding CanTakeOver}" Visibility="{Binding ShowTakeover, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="TakeOverClient" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
            <Border Padding="20" Style="{StaticResource ProviderCard}" Visibility="{Binding HasProviders, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{i18n:T 还没有供应商}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <ui:Button Content="{i18n:T 新增供应商}" Command="{Binding AddProviderCommand}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{i18n:T 没有匹配的供应商}" Margin="0,0,0,10" Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="1"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasProviders}" Value="False"><Setter Property="Opacity" Value="0"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <ItemsControl x:Name="ProviderList" ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource ProviderCard}" AllowDrop="True" Drop="OnProviderDrop" DragOver="OnDragOver" AutomationProperties.AutomationId="{Binding Id}">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="≡" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="{i18n:T 拖动排序}"
                                           PreviewMouseLeftButtonDown="OnDragStart" MouseMove="OnProviderDrag" />
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Host}" ToolTip="{Binding Url}" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource SecondaryText}" ToolTip="{Binding Model}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Open24}" Command="{Binding WebsiteCommand}" ToolTip="{i18n:T 打开官网}"
                                           Visibility="{Binding HasWebsite, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Padding="6" />
                                <ui:Button Grid.Column="3" Content="{i18n:T 刷新余额}" Command="{Binding RefreshBalanceCommand}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Padding="8,4" AutomationProperties.AutomationId="{Binding RefreshBalanceId}"
                                           Visibility="{Binding BalanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:Button Grid.Column="4" Content="⋯" Click="OnMenuClick" VerticalAlignment="Center" Margin="6,0,0,0" Padding="8,3" AutomationProperties.Name="{i18n:T 供应商操作}" AutomationProperties.AutomationId="{Binding MenuId}">
                                    <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{i18n:T 编辑}" Command="{Binding EditCommand}" />
                                        <MenuItem Header="{i18n:T 复制供应商}" Command="{Binding DuplicateCommand}" />
                                        <MenuItem Header="{i18n:T 准备全部 Key}" Command="{Binding PrepareAllCommand}" />
                                        <MenuItem Header="{i18n:T 打开官网}" Command="{Binding WebsiteCommand}" IsEnabled="{Binding HasWebsite}" />
                                        <Separator/><MenuItem Header="{i18n:T 删除}" Command="{Binding DeleteCommand}" />
                                    </ContextMenu></ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Keys}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,3" AllowDrop="True" Drop="OnKeyDrop"><Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Marker}" Margin="2,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="{i18n:T 拖动排序}"
                                               PreviewMouseLeftButtonDown="OnDragStart" MouseMove="OnKeyDrag" />
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding MaskedKey}" FontFamily="Consolas" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding Balance}" ToolTip="{Binding BalanceHint}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding BalanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="{Binding BalanceStatusId}">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Style.Triggers><DataTrigger Binding="{Binding BalanceCritical}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PreparationState}" ToolTip="{Binding PreparationHint}" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="{Binding PreparationStatusId}">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                <Style.Triggers><DataTrigger Binding="{Binding PreparationFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="{Binding SwitchText}" Command="{Binding SwitchCommand}" VerticalAlignment="Center" Padding="10,4" AutomationProperties.AutomationId="{Binding Id}" />
                                    <ui:Button Grid.Column="3" Content="{Binding PreparationAction}" Command="{Binding PrepareCommand}" Margin="6,0,0,0" VerticalAlignment="Center" Padding="8,4" AutomationProperties.AutomationId="{Binding PrepareId}" />
                                    <ui:Button Grid.Column="4" Content="⋯" Margin="6,0,0,0" Click="OnMenuClick" VerticalAlignment="Center" Padding="8,3" AutomationProperties.Name="{i18n:T Key 操作}">
                                        <ui:Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{i18n:T 编辑}" Command="{Binding EditCommand}" />
                                            <MenuItem Header="{i18n:T 复制 Key}" Command="{Binding CopyCommand}" />
                                            <Separator/><MenuItem Header="{i18n:T 删除}" Command="{Binding DeleteCommand}" />
                                        </ContextMenu></ui:Button.ContextMenu>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Content="{i18n:T 添加 Key}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddKeyCommand}" Padding="8,4" />
                                <ui:Button Content="{i18n:T 准备全部 Key}" Command="{Binding PrepareAllCommand}" Margin="8,0,0,0" Padding="8,4" AutomationProperties.AutomationId="{Binding PrepareAllId}" />
                                <ui:Button Content="{Binding FoldText}" Command="{Binding FoldCommand}" Margin="8,0,0,0" Padding="8,4" Visibility="{Binding CanFold, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
