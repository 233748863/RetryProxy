<UserControl x:Class="RetryProxy.View.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i18n="clr-namespace:RetryProxy.Service.I18n"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:RetryProxy.ViewModel.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=pages:OverviewPageViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="700"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!--  今日请求瓦片  -->
        <ui:Card Margin="0,0,0,12" Padding="14,10">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{i18n:T 今日请求}" />
                <UniformGrid Columns="5">
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="OverviewTotalRequests"
                                       Style="{StaticResource TileValue}"
                                       Text="{Binding TotalRequests}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 今日请求}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource TileValue}"
                                       Text="{Binding SuccessfulRequests}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 成功}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Style="{StaticResource TileValue}"
                                       Text="{Binding RetryCount}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 重试}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource TileValue}"
                                       Text="{Binding FailedRequests}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 失败}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0" Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Style="{StaticResource TileValue}"
                                       Text="{Binding ActiveRequests}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{i18n:T 用户处理中}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ui:Card>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  今日缓存摘要  -->
            <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{i18n:T 今日缓存命中}" />
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding RateHelp}">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{Binding HitRateBrush}"
                                   Text="{Binding HitRateText}" />
                    </StackPanel>
                    <ProgressBar Height="5"
                                 Margin="0,6,0,6"
                                 Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                 Maximum="100"
                                 ToolTip="{Binding HitRateHelp}"
                                 Value="{Binding HitRateProgress, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding MeasuredText}"
                               ToolTip="{Binding RateHelp}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding CreationText}"
                               ToolTip="{Binding CreationHelp}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MutedText}"
                               Text="{Binding LatestDetail}"
                               ToolTip="{Binding LatestHelp}" />
                </StackPanel>
            </ui:Card>

            <!--  最近 7 天  -->
            <ui:Card Grid.Column="1" Margin="6,0,0,0" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{i18n:T 最近 7 天}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding TrendSummary}"
                               ToolTip="{Binding RateHelp}" />
                    <Grid Height="98" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Trend}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0" ToolTip="{Binding ToolTip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom"
                                                Background="{Binding Brush}"
                                                CornerRadius="3" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding RequestsText}" />
                                        <TextBlock Grid.Row="2"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding DateLabel}" />
                                        <TextBlock Grid.Row="3"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{Binding Brush}"
                                                   Text="{Binding RateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{i18n:T 暂无历史统计}"
                                   Visibility="{Binding TrendIsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  按模型拆分  -->
            <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{i18n:T 按模型拆分}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 模型}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="{i18n:T 请求}" />
                        <TextBlock Grid.Column="2" Margin="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 命中率}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ModelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Requests}" />
                                    <TextBlock Grid.Column="2"
                                               MinWidth="52"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding RateBrush}"
                                               Text="{Binding Rate}"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{i18n:T 暂无成功请求的用量记录}"
                               Visibility="{Binding HasModelRows, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                </StackPanel>
            </ui:Card>

            <!--  按 Key 拆分  -->
            <ui:Card Grid.Column="1" Margin="6,0,0,0" Padding="14" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{i18n:T 按 Key 拆分}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T Key}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnLabel}" Text="{i18n:T 请求}" />
                        <TextBlock Grid.Column="2" Margin="0" Style="{StaticResource ColumnLabel}" Text="{i18n:T 命中率}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Requests}" />
                                    <TextBlock Grid.Column="2"
                                               MinWidth="52"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding RateBrush}"
                                               Text="{Binding Rate}"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{i18n:T 暂无成功请求的用量记录}"
                               Visibility="{Binding HasKeyRows, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </StackPanel>
</UserControl>
